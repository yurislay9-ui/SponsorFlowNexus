<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_expand"
        android:rotation="180"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        app:tint="@color/text_secondary"
        android:layout_gravity="start" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Verifica tu correo"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Te enviamos un código a tu correo"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Code Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_code_1"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:inputType="number"
        android:maxLength="1"
        android:gravity="center"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_code_input"
        android:layout_marginEnd="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_code_2"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:inputType="number"
        android:maxLength="1"
        android:gravity="center"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_code_input"
        android:layout_marginEnd="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_code_3"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:inputType="number"
        android:maxLength="1"
        android:gravity="center"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_code_input"
        android:layout_marginEnd="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_code_4"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:inputType="number"
        android:maxLength="1"
        android:gravity="center"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_code_input"
        android:layout_marginEnd="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_code_5"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:inputType="number"
        android:maxLength="1"
        android:gravity="center"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_code_input"
        android:layout_marginEnd="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_code_6"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:inputType="number"
        android:maxLength="1"
        android:gravity="center"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_code_input" />

    </LinearLayout>

    <!-- Verify Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_verify"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="Verificar"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp" />

    <!-- Resend Code -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿No recibiste el código? "
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_resend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reenviar"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Timer -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Espera 60 segundos"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

</LinearLayout>
